# Copy to .env and fill in. Never commit a real .env with secrets.
# Windows:  copy .env.example .env
PORT=3000
# MongoDB — database name is smart-train-db, as in your Compass screenshots.
# Local: mongodb://127.0.0.1:27017/smart-train-db
# Atlas: mongodb+srv://<user>:<password>@<cluster>/smart-train-db?retryWrites=true&w=majority
# If this cannot be reached, the server logs a warning and keeps working
# with in-memory storage (data is lost on restart) so you can still demo
# the dashboard without MongoDB.
MONGO_URI=mongodb://127.0.0.1:27017/smart-train-db
JWT_SECRET=change-this-to-a-long-random-secret
# Seed the screenshot users/trains on first run only (empty users collection).
# Set to false to skip seeding. Seed passwords are in README.md, NOT on the login page.
SEED_DEMO_USERS=true
# Which station / section the USB node belongs to (used for SS/TI scopes).
# Use a station NAME: Mysuru, Mandya or Bengaluru — not station-1.
NODE_STATION_NAME=Mysuru
NODE_SECTION_ID=section-1
# USB serial for the Arduino/ESP32 node. Leave empty to run without hardware.
# Examples: COM3 (Windows), /dev/ttyUSB0 (Linux), /dev/tty.usbserial-XXXX (macOS)
SERIAL_PORT=
SERIAL_BAUD=115200
# Key a Wi-Fi node must send as header  x-device-key: <key>
# to use POST /api/device/ingest. Set a strong random value before hosting,
# and put the SAME value in firmware/smartrail_node_wifi.ino.
DEVICE_API_KEY=change-this-device-key
# Set to true ONLY for a dashboard demo with no hardware attached.
SIMULATE_DEVICE=false
# How long repeat detections of the same obstacle are merged into one incident (ms)
INCIDENT_MERGE_WINDOW_MS=300000
